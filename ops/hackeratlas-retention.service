[Unit]
Description=Expire private Hacker Atlas history
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/technews
Environment=TZ=Europe/Stockholm
EnvironmentFile=-%h/technews/.env
ExecStart=/bin/bash -c 'source scripts/node_env.sh; exec .venv/bin/python -u scripts/retention.py'
TimeoutStartSec=30min
